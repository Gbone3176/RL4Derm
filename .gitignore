# DermoGPT repository hygiene for cross-server GitHub sync.
# Track source code, scripts, prompts, agent rules, and environment specs.
# Do not track datasets, model weights, checkpoints, logs, caches, or run outputs.

###############################################################################
# Local archives and temporary workspaces
###############################################################################
rubbish/
tmp/
paper_review/

###############################################################################
# Python and test artifacts
###############################################################################
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/

###############################################################################
# Build and package artifacts
###############################################################################
build/
dist/
*.egg-info/
pip-wheel-metadata/
*.whl

###############################################################################
# Local launch scripts
###############################################################################
/scripts/

###############################################################################
# Local environments and secrets
###############################################################################
.env
.env.*
!.env.example
.venv/
venv/
env/
ENV/
condaenv.*.requirements.txt

###############################################################################
# Editor, OS, and local agent runtime state
###############################################################################
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
.omx/
.omc/

###############################################################################
# Data files and derived dataset snapshots
###############################################################################
data/*
!data/
!data/.gitkeep
!data/**/
!data/**/*.json

# Keep benchmark scripts trackable, but exclude large benchmark payloads.
dataset_final/benchmark/**/*.json
dataset_final/benchmark/**/*.jsonl

###############################################################################
# Agent rules, harness config, and environment spec (local-only)
###############################################################################
AGENTS.md
dermogpt-harness.yaml
environment.yaml
HARNESS.md

###############################################################################
# Experiment outputs and trackers
###############################################################################
/experiment/

# Sync only the three canonical Markdown registries from the experiments tree;
# experiment directories and every other file remain local-only.
/experiments/**
!/experiments/
!/experiments/EXP_SUM.md
!/experiments/IDEAS.md
!/experiments/TEST_SUM.md

# Migration bookkeeping stays local and must not be synchronized.
/experiments/STRUCTURE_MIGRATION_20260803.md
/experiments/STRUCTURE_MIGRATION_20260803.tsv

output/
outputs/
runs/
logs/
wandb/
swanlog/
**/swanlog/
*.log

###############################################################################
# Model weights, checkpoints, adapters, and binary artifacts
###############################################################################
checkpoint-*/
**/checkpoint-*/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.gguf
*.npz
*.npy

###############################################################################
# Local model/package caches
###############################################################################
.cache/
cache/
modelscope_cache/
huggingface/
hf_cache/
trl_wheels/
AGENTS.md
